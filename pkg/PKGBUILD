# Maintainer: Italo Cunha Cisar Pinheiro <101741037+amendoa657@users.noreply.github.com>

pkgname=mosaic-store-git
_pkgname=mosaic-store
pkgver=0.6.0
pkgrel=1
pkgdesc="Loja de pacotes do Arch Linux (repositórios oficiais e AUR) com a cara do seu wallpaper"
arch=('any')
url="https://github.com/amendoa657/mosaicStore"
license=('GPL-3.0-or-later' 'OFL-1.1') # OFL-1.1 é das fontes
depends=(
  'python'
  'python-flask'
  'python-requests'
  'python-pywebview'
  'python-qtpy'
  'pyside6'
  'qt6-webengine'
  'qt6-svg'        # o ícone da janela, que é SVG
  'paru'           # instala os pacotes da AUR
  'pacman-contrib' # checkupdates, na tela de Atualizações
  'polkit'         # pkexec
  'seahorse'       # /usr/lib/seahorse/ssh-askpass, a janela da senha
)
makedepends=('git')
optdepends=('matugen: tema a partir do wallpaper')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+https://github.com/amendoa657/mosaicStore.git"
  "mosaic-store.sh"
  "mosaic-store.desktop")
sha256sums=('SKIP'
  '646f7116417c2eb8a41334aebd30cee9d8736cfeafcbb71377a64f481d48f6d4'
  '878385ae438568e35e25e583622c0b22a9353165f18648621a54b184fceb43de')

# A versão sai da última tag: v0.6.0 com 3 commits depois vira 0.6.0.r3.gabc1234.
pkgver() {
  cd "$_pkgname"
  git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

package() {
  cd "$_pkgname"

  # O app roda direto do código, em /usr/share/mosaic-store. O que ele grava
  # (banco e downloads) vai para ~/.cache/mosaic-store, e a configuração para
  # ~/.config/mosaic-store.
  install -d "$pkgdir/usr/share/$_pkgname"
  cp -a app.py config controllers database models repositories services system \
    templates static mosaic-ui "$pkgdir/usr/share/$_pkgname/"
  find "$pkgdir/usr/share/$_pkgname" -name __pycache__ -prune -exec rm -rf {} +
  python -m compileall -q -d "/usr/share/$_pkgname" "$pkgdir/usr/share/$_pkgname"

  install -Dm755 "$srcdir/mosaic-store.sh" "$pkgdir/usr/bin/mosaic-store"
  install -Dm644 "$srcdir/mosaic-store.desktop" -t "$pkgdir/usr/share/applications/"
  # Só o SVG: o app grava o ícone nas cores do tema em ~/.local/share/icons,
  # que ganha deste. Um PNG de tamanho fixo aqui ganharia do SVG do usuário.
  install -Dm644 static/icone.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/mosaic-store.svg"
  install -Dm644 mosaic-ui/fontes/LICENSE-* -t "$pkgdir/usr/share/licenses/$pkgname/"
}
